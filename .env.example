# CLIENT
# AUTHENTICATION_SECRET belongs only in server/user_service environments.
# Never add it here or expose it through a VITE_* variable or bootstrap response.
VITE_PUBLIC_CHATTERLOOP_API=
VITE_PUBLIC_CHATTERLOOP_USER_SERVICE_API=
VITE_PUBLIC_OPEN_ROUTE_API=
VITE_SECRET_OPEN_ROUTE_API_KEY=
# Client payload/response and nonce key: match server JWT_SECRET/user_service JWT_TOKEN.
# This is NOT the server-only AUTHENTICATION_SECRET.
VITE_SECRET_JWT_SECRET=shared-client-payload-and-nonce-key
VITE_PUBLIC_GOOGLE_CLIENT_ID=
VITE_PUBLIC_APP_GOOGLE_USERINFO_API=
VITE_PUBLIC_TURN_SERVER_URL=
VITE_SECRET_TURN_SERVER_USERNAME=
VITE_SECRET_TURN_SERVER_CREDENTIAL=
# SERVER
# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password
# Origin
ALLOWED_ORIGIN=